# Copia este archivo como .env y completa los valores.
# Conexión a PostgreSQL (usuario:contraseña@servidor:puerto/base)
DATABASE_URL=postgres://hub:cambia-esta-clave@localhost:5432/hub
PORT=8080
# Dirección de la app en GitHub Pages (sin barra final). Permite que esa app use este servidor.
ALLOWED_ORIGIN=https://USUARIO.github.io
# Clave larga y aleatoria para firmar las sesiones (por ejemplo, 64 caracteres)
SESSION_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria
# Carpeta donde se guardan los archivos de impresión y corte
# Clave de cifrado de datos personales (64 caracteres hexadecimales). Si se deja vacía, el servidor
# crea el archivo .data-key la primera vez. RESPALDA esa clave: sin ella no se pueden leer RUT, correos ni teléfonos.
DATA_KEY=
UPLOADS_DIR=./uploads
MAX_UPLOAD_MB=4096
# Contraseña de aplicación de Google para la cuenta que envía correos (Apariencia y reglas › Correo).
# Si queda vacía, los correos se guardan en la tabla outbox sin enviarse.
SMTP_PASS=
# Enlace para dejar de recibir avisos que va al final de cada aviso por correo (opcional).
# PUBLIC_APP_URL: dirección pública de la app (si ya la pusiste en Apariencia y reglas › Dirección pública, no hace falta).
# PUBLIC_API_URL: dirección pública de este servidor (la de Tailscale Funnel). Con ella los programas de correo
# muestran el botón "Cancelar suscripción" (baja de un clic) y el enlace funciona aunque la app no tenga dirección pública.
PUBLIC_APP_URL=
# Pedidos más lentos que esto (ms) se anotan en la ventana del servidor como [lento]. Por defecto 400.
# SLOW_MS=400
PUBLIC_API_URL=
# Solo para "npm run db:init -- --clean": cuenta de administración inicial
ADMIN_EMAIL=roderick.grez@mayor.cl
ADMIN_PASSWORD=
# Para docker compose
POSTGRES_PASSWORD=cambia-esta-clave
